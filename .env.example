# Copy to .env, or run `npm run setup`, which creates .env from this file and fills the three secrets.
# Never commit .env. Every variable is read in config/env.js (the only place that reads process.env).

# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app (1 for nginx and most hosting platforms). Leave empty when none.
TRUST_PROXY=
LOG_LEVEL=info
# true = colored readable logs, false = plain JSON. Empty = colored only in a development terminal.
LOG_PRETTY=

# ---------------------------------------------------------------- database
# Put the database name at the end of the URI (...mongodb.net/travel_db), or MongoDB uses "test".
MONGODB_URI=mongodb://127.0.0.1:27017/travel_db

# ---------------------------------------------------------------- secrets (three DIFFERENT values, 32+ characters)
# `npm run setup` replaces every "replace-me" below with a random value.
# By hand: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
TOKEN_HASH_SECRET=replace-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST=12

# ---------------------------------------------------------------- front ends (CORS allow-list, comma separated)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Base URL used in emailed links. Defaults to the first CLIENT_URL.
APP_URL=

# ---------------------------------------------------------------- refresh cookie
# Use "none" only when the front end and the API are on different sites (needs HTTPS and COOKIE_SECURE=true).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=
COOKIE_DOMAIN=

# ---------------------------------------------------------------- codes and invites
OTP_EXPIRES_MINUTES=10
# Minimum seconds between two codes for the same account. Default 60.
OTP_RESEND_COOLDOWN_SECONDS=
STAFF_INVITE_EXPIRES_HOURS=48

# ---------------------------------------------------------------- email (EmailJS)
# With all four EMAILJS_* values set, emails are sent for real. Without them, development prints each email to the
# server log. EMAIL_PROVIDER can force "console" (development only).
APP_NAME=Travel Management Platform
APP_TIMEZONE=Asia/Dhaka
EMAIL_PROVIDER=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
# Optional second template used only for emails that carry a code. Empty = EMAILJS_TEMPLATE_ID for everything.
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ---------------------------------------------------------------- Firebase (Google sign-in for customers)
# Disabled until you give it a service account. Use EITHER the path OR the three values.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The whole key on ONE line, with \n for line breaks, inside double quotes.
FIREBASE_PRIVATE_KEY=
# Sign-in methods the API accepts. Email and password is deliberately not allowed here.
FIREBASE_ALLOWED_PROVIDERS=google.com

# ---------------------------------------------------------------- first admin (npm run seed)
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=
# 8+ characters with upper, lower, number and symbol. Set it, run `npm run seed`, then you may remove it.
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------- files and limits
PRIVATE_STORAGE_DIR=
# Set to false to switch rate limiting off (development only). On by default.
RATE_LIMIT_ENABLED=true
