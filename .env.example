# Copy to .env, or run `npm run setup`, which creates .env from this file and fills the three secrets.
# Never commit .env. Optional settings that are not listed here are in the README, under "Environment variables".

# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app (1 for nginx and most hosting platforms). Leave empty when none.
TRUST_PROXY=

# ---------------------------------------------------------------- database
# Put the database name at the end of the URI (...mongodb.net/travel_db), or MongoDB uses "test".
MONGODB_URI=mongodb://127.0.0.1:27017/travel_db

# ---------------------------------------------------------------- secrets (three DIFFERENT values, 32+ characters)
# `npm run setup` replaces every "replace-me" below with a random value.
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
TOKEN_HASH_SECRET=replace-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------- front ends (CORS allow-list, comma separated)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Base URL used in emailed links. Empty = the first CLIENT_URL.
APP_URL=
# Use "none" only when the front end and the API are on different sites (needs HTTPS).
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------- email (EmailJS)
# Codes are only ever sent by email, never printed. Without all four EMAILJS_* values no email can be sent.
APP_NAME=Travel Management Platform
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ---------------------------------------------------------------- Firebase (Google sign-in for customers)
# Disabled until you give it a service account. Use EITHER the path OR the three values.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The whole key on ONE line, with \n for line breaks, inside double quotes.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------- first admin (npm run seed)
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=
# 8+ characters with upper, lower, number and symbol. Set it, run `npm run seed`, then you may remove it.
ADMIN_SEED_PASSWORD=
