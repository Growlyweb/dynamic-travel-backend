{
  "name": "express-mongo-boilerplate",
  "version": "1.0.0",
  "description": "Layered Express + MongoDB REST API boilerplate with central auth and role-based access control (ADMIN, STAFF, B2B, B2C)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node scripts/initEnv.js",
    "console": "node test/console/server.js",
    "openapi": "node scripts/generateOpenApi.js",
    "seed": "node scripts/seedData.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --runInBand --watch",
    "e2e": "playwright test -c test/playwright.config.js",
    "e2e:api": "playwright test -c test/playwright.config.js --project=api",
    "e2e:ui": "playwright test -c test/playwright.config.js --project=ui"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/unit/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/test/unit/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/test/unit/setup/globalTeardown.js",
    "setupFilesAfterEnv": [
      "<rootDir>/test/unit/setup/setupAfterEnv.js"
    ],
    "testTimeout": 30000
  },
  "nodemonConfig": {
    "watch": ["server.js", "app.js", "config", "controllers", "middleware", "models", "routes", "services", "utils", "validations"],
    "ext": "js,json",
    "ignore": ["test", "documentation", "scripts", "storage"]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^2.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@playwright/test": "^1.63.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1"
  }
}
